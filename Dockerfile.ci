# Image d'usine : le pipeline a DEJA compile et teste — on ne fait qu'emballer le jar.
# (Recompiler dans le Dockerfile = double build + cache froid : lecon du dry run v1.)
FROM eclipse-temurin:21-jre-alpine
WORKDIR /app
RUN addgroup -S app && adduser -S app -G app
USER app
COPY target/*.jar app.jar
EXPOSE 8080
ENTRYPOINT ["java", "-jar", "app.jar"]
